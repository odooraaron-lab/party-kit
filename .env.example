# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Your site's public address (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe → Developers → API keys. Use the sk_test_ key until launch.
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe → Developers → Webhooks (or the value `stripe listen` prints locally)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (resend.com) for order emails. Leave blank and emails are printed to the console instead.
RESEND_API_KEY=
EMAIL_FROM="Party Shop <orders@yourdomain.co.nz>"

# Where new-order notifications go (you)
SHOP_OWNER_EMAIL=you@example.co.nz

# Stripe → Developers → API keys → Publishable key (pk_test_…). Safe to expose.
# Only used for the "or 4 payments with Afterpay/Klarna" line on product and cart pages.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Birthday TV Story ──
# Your main domain WITHOUT www or https, e.g. mywebsite.co.nz
# Stories live at <name>.mywebsite.co.nz. Leave blank locally (stories use /p/<name>).
NEXT_PUBLIC_ROOT_DOMAIN=

# Postgres connection string (Vercel → Storage → Neon adds this automatically).
# Leave blank locally to use a JSON file in .data/
DATABASE_URL=

# ── Photo Wall ──
# Vercel → Storage → create a Blob store and connect it (adds this automatically).
# Leave blank locally: photos are saved in .data/uploads instead.
BLOB_READ_WRITE_TOKEN=
# Protects the daily cleanup job that deletes expired albums (Vercel sends it automatically once set).
CRON_SECRET=

# ── Reviews ──
# Any long random string. Signs the one-click "Approve / Reject" links in new-review emails.
ADMIN_SECRET=

# ── Admin (HQ) ──
# The admin's address, e.g. https://admin.yourbrand.nz. Leave blank to run without the admin.
HQ_URL=
# One secret per app: Admin → Products → story / photos / slideshow.
HQ_SECRET_STORY=
HQ_SECRET_PHOTOS=
HQ_SECRET_SLIDESHOW=
